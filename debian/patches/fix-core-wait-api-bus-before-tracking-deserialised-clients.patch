-
-        u->deserialized_refs = strv_free(u->deserialized_refs);
+        RET_GATHER(r, bus_unit_coldplug_bus_track(u));
 
         if (UNIT_VTABLE(u)->coldplug)
                 RET_GATHER(r, UNIT_VTABLE(u)->coldplug(u));
