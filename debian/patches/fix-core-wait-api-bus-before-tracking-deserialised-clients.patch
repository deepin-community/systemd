         for (CGroupIPAccountingMetric m = 0; m < _CGROUP_IP_ACCOUNTING_METRIC_MAX; m++) {
                 uint64_t v;
Index: systemd/src/core/unit.c
===================================================================
--- systemd.orig/src/core/unit.c
+++ systemd/src/core/unit.c
@@ -459,7 +459,7 @@ bool unit_may_gc(Unit *u) {
         if (u->in_dbus_queue)
                 return false;
 
-        if (sd_bus_track_count(u->bus_track) > 0)
+        if (sd_bus_track_count(u->bus_track) > 0 || !strv_isempty(u->deserialized_refs))
                 return false;
 
         state = unit_active_state(u);
@@ -3846,10 +3846,7 @@ int unit_coldplug(Unit *u) {
 
         u->coldplugged = true;
 
-        STRV_FOREACH(i, u->deserialized_refs)
