From 454a9cab0ab7f6f76823aab48d1bfae60643b797 Mon Sep 17 00:00:00 2001
From: Yu Watanabe <watanabe.yu+github@gmail.com>
Date: Tue, 24 Nov 2026 21:12:12 +0900
Subject: [PATCH] tree-wide: catch .n_ref reference counter overflows
 universally (#45005)

We already did this right in DEFINE_TRIVIAL_REF_FUNC(), but let's do so
for all other ref counters too.

Fixes: #45002


[v255 backport note: systemd 255.2 has a different source layout than the v257
tree this commit was written for, so several hunks are re-targeted onto the
equivalent v255 files instead of being dropped:
  - src/basic/cleanup-util.h -> src/basic/macro.h: cleanup-util.h does not
    exist in v255, hence ref_counter_inc()/ref_counter_dec() are added to
    macro.h right next to _DEFINE_TRIVIAL_REF_FUNC() and
    _DEFINE_TRIVIAL_UNREF_FUNC(), which are converted to use them.
  - src/libsystemd/sd-json/sd-json.c -> src/shared/json.c: v255 still ships
    JsonVariant in src/shared/json.c (renamed to sd-json later); the same
    overflow guard is applied to json_variant_ref()/json_variant_unref().
  - src/shared/dns-packet.c -> src/resolve/resolved-dns-packet.c and
    src/shared/dns-rr.c -> src/resolve/resolved-dns-rr.c: in v255 these files
    still live in src/resolve/. dns_packet_unref() keeps the v255 statement
    ordering (drop p->more before freeing) and only replaces the manual
    refcount handling with ref_counter_dec().]
---
diff --git a/src/basic/macro.h b/src/basic/macro.h
index d3eb980a..f273937e 100644
--- a/src/basic/macro.h
+++ b/src/basic/macro.h
@@ -4,6 +4,7 @@
 #include <assert.h>
 #include <errno.h>
 #include <inttypes.h>
+#include <limits.h>
 #include <stdbool.h>
 #include <sys/param.h>
 #include <sys/sysmacros.h>
@@ -281,17 +282,36 @@ static inline int __coverity_check_and_return__(int condition) {
 #define FOREACH_ARRAY(i, array, num)                                    \
         _FOREACH_ARRAY(i, array, num, UNIQ_T(m, UNIQ), UNIQ_T(end, UNIQ))
 
+static inline void ref_counter_inc(unsigned *n) {
+        assert(n);
+
+        /* Increases a reference counter, but refuses to let it overflow. Getting anywhere near UINT_MAX
+         * references to a single object almost certainly means references are leaked somewhere (keeping
+         * that many legitimate references around would require tens of GiB of memory just for the
+         * pointers), i.e. it's a programming error, hence abort instead of returning an error. Note that we
+         * use assert_se() here rather than assert(), so that this check is not compiled out with NDEBUG:
+         * allowing the counter to wrap around would result in the object being freed while it is still
+         * referenced, i.e. in a use-after-free. */
+        assert_se(*n < UINT_MAX);
+        (*n)++;
+}
+
+static inline unsigned ref_counter_dec(unsigned *n) {
+        assert(n);
+
+        /* Decreases a reference counter, and returns the new value. Dropping a reference that was never
+         * taken is a programming error, hence assert on that. */
+        assert(*n > 0);
+        return --(*n);
+}
+
 #define _DEFINE_TRIVIAL_REF_FUNC(type, name, scope)             \
         scope type *name##_ref(type *p) {                       \
                 if (!p)                                         \
                         return NULL;                            \
                                                                 \
-                /* For type check. */                           \
-                unsigned *q = &p->n_ref;                        \
-                assert(*q > 0);                                 \
-                assert_se(*q < UINT_MAX);                       \
-                                                                \
-                (*q)++;                                         \
+                assert(p->n_ref > 0);                           \
+                ref_counter_inc(&p->n_ref);                     \
                 return p;                                       \
         }
 
@@ -300,9 +320,7 @@ static inline int __coverity_check_and_return__(int condition) {
                 if (!p)                                          \
                         return NULL;                             \
                                                                  \
-                assert(p->n_ref > 0);                            \
-                p->n_ref--;                                      \
-                if (p->n_ref > 0)                                \
+                if (ref_counter_dec(&p->n_ref) > 0)               \
                         return NULL;                             \
                                                                  \
                 return free_func(p);                             \
