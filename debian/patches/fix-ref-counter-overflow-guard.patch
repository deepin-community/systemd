+++ b/src/core/execute.c
@@ -1990,10 +1990,7 @@ ExecSharedRuntime* exec_shared_runtime_destroy(ExecSharedRuntime *rt) {
         if (!rt)
                 return NULL;
 
-        assert(rt->n_ref > 0);
-        rt->n_ref--;
