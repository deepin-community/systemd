+
+                z = (struct tpm2_pinned_srk_credential_header*) ((uint8_t*) output.iov_base + p);
+                z->size = htole32(tpm2_srk.iov_len);
+                memcpy(z->data, tpm2_srk.iov_base, tpm2_srk.iov_len);
