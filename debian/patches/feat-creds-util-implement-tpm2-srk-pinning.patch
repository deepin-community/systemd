         /* Followed by NUL bytes until next 8 byte boundary */
 };
 
+struct _packed_ tpm2_pinned_srk_credential_header {
+        le32_t size;          /* Size of pinned SRK */
+        uint8_t data[];       /* Pinned SRK */
+        /* Followed by NUL bytes until next 8 byte boundary */
