From 640215c27e73be0c030e9f5b6759c29ac7a3235c Mon Sep 17 00:00:00 2001
From: Siteshwar Vashisht <svashisht@redhat.com>
Date: Fri, 13 Nov 2026 11:41:10 +0100
Subject: [PATCH] core: deserialize `exec-fd-hot` during daemon-reexec

It was serialized during `daemon-reexec` but never deserialized.

Index: repo/src/core/service.c
===================================================================
--- repo.orig/src/core/service.c
+++ repo/src/core/service.c
@@ -3212,6 +3212,13 @@ static int service_deserialize_item(Unit
                 r = free_and_strdup(&s->bus_name_owner, value);
                 if (r < 0)
                         log_unit_error_errno(u, r, "Unable to deserialize current bus owner %s: %m", value);
+        } else if (streq(key, "exec-fd-hot")) {
+                r = parse_boolean(value);
+                if (r < 0)
+                        log_unit_debug_errno(u, r, "Failed to parse exec-fd-hot value: %s", value);
+                else
+                        s->exec_fd_hot = r;
+
         } else if (streq(key, "status-text")) {
                 char *t;
                 ssize_t l;
