From e5058834cf7265084cbff660282afbcb70aef8d5 Mon Sep 17 00:00:00 2001
From: Luca Boccassi <bluca@debian.org>
Date: Wed, 5 Jun 2024 17:41:55 +0100
Subject: [PATCH] Merge pull request #33197 from
 poettering/cryptsetup-fallback-tweak

cryptsetup: unset an unlock path on each unlock retry

Index: systemd/src/cryptsetup/cryptsetup.c
===================================================================
--- systemd.orig/src/cryptsetup/cryptsetup.c
+++ systemd/src/cryptsetup/cryptsetup.c
@@ -2326,6 +2326,7 @@ static int run(int argc, char *argv[]) {
                 }
 #endif
 
+                bool use_cached_passphrase = true;
                 _cleanup_strv_free_erase_ char **passwords = NULL;
                 for (tries = 0; arg_tries == 0 || tries < arg_tries; tries++) {
                         log_debug("Beginning attempt %u to unlock.", tries);
@@ -2361,7 +2362,8 @@ static int run(int argc, char *argv[]) {
                                                         return log_error_errno(SYNTHETIC_ERRNO(EINVAL), "No passphrase or recovery key registered.");
                                         }
 
-                                        r = get_password(volume, source, until, tries == 0 && !arg_verify, passphrase_type, &passwords);
+                                        r = get_password(volume, source, until, use_cached_passphrase && !arg_verify, passphrase_type, &passwords);
+                                        use_cached_passphrase = false;
                                         if (r == -EAGAIN)
                                                 continue;
                                         if (r < 0)
