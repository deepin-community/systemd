+static VARLINK_DEFINE_METHOD(
+                QueryFilter,
+                VARLINK_DEFINE_OUTPUT(filterDomains, VARLINK_STRING, VARLINK_NULLABLE|VARLINK_ARRAY),
+                VARLINK_DEFINE_OUTPUT(filterLabelsMin, VARLINK_INT, VARLINK_NULLABLE),
+                VARLINK_DEFINE_OUTPUT(filterLabelsMax, VARLINK_INT, VARLINK_NULLABLE));
+
+static VARLINK_DEFINE_METHOD(
+                ResolveRecord,
+                VARLINK_DEFINE_INPUT_BY_TYPE(question, Question, VARLINK_ARRAY),
+                VARLINK_DEFINE_OUTPUT(rcode, VARLINK_INT, VARLINK_NULLABLE),
+                VARLINK_DEFINE_OUTPUT_BY_TYPE(answer, Answer, VARLINK_ARRAY|VARLINK_NULLABLE));
+
+VARLINK_DEFINE_INTERFACE(
+                io_systemd_Resolve_Hook,
+                "io.systemd.Resolve.Hook",
+                &vl_type_Answer,
+                &vl_type_Question,
+                &vl_type_ResourceKey,
+                &vl_type_ResourceRecord,
+                &vl_method_QueryFilter,
+                &vl_method_ResolveRecord);
