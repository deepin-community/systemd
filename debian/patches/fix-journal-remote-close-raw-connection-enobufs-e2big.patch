From ef7936e42e3d714a6560bb4e0d5a99fd6fcdacce Mon Sep 17 00:00:00 2001
From: Alvaro Leiva Geisse <aleivag@gmail.com>
Date: Sat, 14 Nov 2026 11:47:09 -0800
Subject: [PATCH] journal-remote: close a raw connection on ENOBUFS and E2BIG,
 like the HTTP path

On ENOBUFS and E2BIG the HTTP path aborts the connection, but the raw
path logged "Entry too big, skipped" or "Entry with too many fields,
skipped" and read on. Nothing is skipped:

- ENOBUFS comes straight back, both for an entry over DATA_SIZE_MAX
  (get_line() returns it again before reading anything) and for a read()
  that fails with it (e.g. a vsock connection the kernel reset on receive
  queue overflow, where the error is sticky). journal-remote then spins
  at 100% CPU, logging millions of lines a second.

- After E2BIG on a binary field the importer stays in
  IMPORTER_STATE_DATA and reads the following bytes as that field's
  payload, out of step with the stream.

The raw stream has no framing to resynchronize on, so let both fall
through to the generic error path and close the connection.

diff --git a/src/journal-remote/journal-remote.c b/src/journal-remote/journal-remote.c
index 4ca1e099ab..bc6d5145d4 100644
--- a/src/journal-remote/journal-remote.c
+++ b/src/journal-remote/journal-remote.c
@@ -396,16 +396,15 @@ int journal_remote_handle_raw_source(
                 remove_source(s, source->importer.fd);
                 log_debug("%zu active sources remaining", s->active);
                 return 0;
-        } else if (r == -E2BIG) {
-                log_notice("Entry with too many fields, skipped");
-                return 1;
-        } else if (r == -ENOBUFS) {
-                log_notice("Entry too big, skipped");
-                return 1;
         } else if (r == -EAGAIN) {
                 return 0;
         } else if (r < 0) {
-                log_debug_errno(r, "Closing connection: %m");
+                /* Close the connection on any error, like the HTTP path does: the raw stream has no
+                 * framing to resynchronize on. ENOBUFS (an entry bigger than DATA_SIZE_MAX, or read()
+                 * itself failing) would come straight back, and after E2BIG (too many fields) the
+                 * importer would read the rest of the entry out of step. */
+                log_notice_errno(r, "Failed to process data, closing connection with source %s: %m",
+                                 source->importer.name);
                 remove_source(s, fd);
                 return 0;
         } else

