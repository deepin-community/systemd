+TEST(config_parse_bind_paths) {
+        _cleanup_(manager_freep) Manager *m = NULL;
+        _cleanup_(unit_freep) Unit *u = NULL;
+        ExecContext c = {};
+        unsigned n_syntax_warnings = 0;
+        int r;
+
+        r = manager_new(RUNTIME_SCOPE_USER, MANAGER_TEST_RUN_MINIMAL, &m);
+        if (manager_errno_skip_test(r)) {
+                log_notice_errno(r, "Skipping test: manager_new: %m");
+                return;
+        }
+
+        assert_se(r >= 0);
+        assert_se(manager_startup(m, NULL, NULL, NULL) >= 0);
+
+        assert_se(u = unit_new(m, sizeof(Service)));
+        assert_se(unit_add_name(u, "foobar.service") >= 0);
+
+        {
+                _unused_ _cleanup_(clear_log_syntax_callback) dummy_t dummy;
+
+                set_log_syntax_callback(count_syntax_warnings, &n_syntax_warnings);
+                assert_se(config_parse_bind_paths(NULL, "fake", 1, "section", 1,
+                                                  "BindReadOnlyPaths", 0,
+                                                  "  /usr/bin  /usr/lib     /lib64   ",
+                                                  &c, u) >= 0);
+        }
+
+        assert_se(n_syntax_warnings == 0);
+        assert_se(c.n_bind_mounts == 3);
+
+        assert_se(streq(c.bind_mounts[0].source, "/usr/bin"));
+        assert_se(streq(c.bind_mounts[0].destination, "/usr/bin"));
+        assert_se(c.bind_mounts[0].read_only);
+        assert_se(c.bind_mounts[0].recursive);
+        assert_se(!c.bind_mounts[0].ignore_enoent);
+
+        assert_se(streq(c.bind_mounts[1].source, "/usr/lib"));
+        assert_se(streq(c.bind_mounts[1].destination, "/usr/lib"));
+        assert_se(c.bind_mounts[1].read_only);
+        assert_se(c.bind_mounts[1].recursive);
+        assert_se(!c.bind_mounts[1].ignore_enoent);
+
+        assert_se(streq(c.bind_mounts[2].source, "/lib64"));
+        assert_se(streq(c.bind_mounts[2].destination, "/lib64"));
+        assert_se(c.bind_mounts[2].read_only);
+        assert_se(c.bind_mounts[2].recursive);
+        assert_se(!c.bind_mounts[2].ignore_enoent);
+
+        exec_context_done(&c);
+}
