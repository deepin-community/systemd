+static void count_syntax_warnings(_unused_ const char *unit, int level, void *userdata) {
+        unsigned *n_syntax_warnings = ASSERT_PTR(userdata);
+
+        if (level <= LOG_WARNING)
+                (*n_syntax_warnings)++;
+}
