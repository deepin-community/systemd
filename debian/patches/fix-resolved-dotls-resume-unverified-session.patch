From fc2ac6898a0a08ae45ee4510d8f63eb3c1cef58b Mon Sep 17 00:00:00 2001
From: Nolan Woods <nolan@i2labs.ca>
Date: Mon, 28 Sep 2026 13:20:31 +0700
Subject: [PATCH] resolved: don't resume DNS-over-TLS sessions that skipped
 verification

The TLS session of a DNS-over-TLS server was only freed together with the
server object, and survived dns_server_reset_features(). Whether the server
certificate is verified is decided per connection from the current
configuration, but resuming a session skips that verification. Hence a
session negotiated in opportunistic mode, without verification, could be
resumed after switching to DNSOverTLS=yes, which is supposed to only accept
servers with a valid certificate.

Therefore remember whether the server certificate was verified when a
session was negotiated, and don't resume a session negotiated without
verification on a connection that requires it. Sessions are only saved
once the handshake completed, so that a handshake that failed
verification can't leave a session behind that is considered verified.

For the same reason, don't keep using a long-lived connection that was
established without verification once verification is required. The
server features aren't necessarily reset when the DNS-over-TLS mode
changes, e.g. not when networkd changes a link's DNSOverTLS= setting, so
such a connection could otherwise keep serving queries.

Additionally, drop the session when the server features are reset, e.g.
when a link's DNSOverTLS= setting is changed via D-Bus, which reallocates
the link's scopes, or on reload.

[v255 backport note: this is the security fix from upstream PR #43922,
extracted from the "resolved: Refactor DnsServer and DnsTransaction"
series. The three refactor commits of that PR (012dfbbd "split DNS server
feature levels into transport and EDNS level", fb387214 "move upstream
transport state into per-transport objects" and d0c7680a "derive the
permitted upstream transports from an encryption policy") are dropped:
they introduce src/resolve/resolved-dns-transport{,-dns,-dot}.{c,h},
DnsTransportKind/DnsTransportVTable/DnsEncryptionMode/
DnsTransportPolicy and src/resolve/resolved-forward.h, none of which
exist in v255.2, whose resolved still selects transports through the
linear DnsServerFeatureLevel enum and stores the stream in DnsServer.
The fix is therefore re-expressed against the v255.2 structures:
- DnsTlsServerData gains session_verified and DnsTlsStreamData gains
  verify; dnstls_server_free() now clears both the session pointer and
  the flag (it previously left a dangling pointer after SSL_SESSION_free()).
- The unverified session is dropped in dnstls_stream_connect_tls() instead
  of in the DnsTransportDot transport, and sessions are only saved on a
  completed handshake in dnstls_stream_shutdown().
- dns_server_reset_features() drops the cached TLS session directly, as
  v255.2 has no per-transport reset_features vtable callback. Streams
  still held by transactions are not detached (v255.2 keeps the session on
  DnsServer, not in a transport object); they can save their session back,
  but it is recorded as unverified and thus never resumed by a connection
  that requires verification.
- dns_transaction_emit_tcp() drops a long-lived TLS stream established
  without verification when verification is now required, replacing the
  upstream DnsTransportVTable.stream_reusable() callback.
- v255.2 has separate resolved-dnstls-openssl.c and
  resolved-dnstls-gnutls.c backends instead of the upstream unified
  resolved-dnstls.c, so the same logic is applied to both. GnuTLS session
  tickets are handled like OpenSSL sessions, and its verification
  predicate is switched to dns_server_get_dns_over_tls_mode() so that it
  agrees with the already backported per-link certificate verification
  fix and with the stream reuse check.
- src/shared/ssl-util.{c,h} do not exist in v255.2 (OpenSSL is linked
  directly through openssl-util.h, not loaded via dlopen()), so the
  SSL_get_verify_result DLSYM() hunk is dropped; the fix does not use it.
- The new src/resolve/test-resolved-transport.c and the
  test-resolved-stream.c hunks are dropped: those tests exercise the
  DnsServerTransport vtable API that v255.2 does not have.]
diff --git a/src/resolve/resolved-dnstls-openssl.h b/src/resolve/resolved-dnstls-openssl.h
--- a/src/resolve/resolved-dnstls-openssl.h
+++ b/src/resolve/resolved-dnstls-openssl.h
@@ -14,11 +14,15 @@
 
 struct DnsTlsServerData {
         SSL_SESSION *session;
+        /* Whether the server certificate was verified when 'session' was negotiated */
+        bool session_verified;
 };
 
 struct DnsTlsStreamData {
         int handshake;
         bool shutdown;
+        /* Whether the server certificate is verified on this connection */
+        bool verify;
         SSL *ssl;
         BUF_MEM *write_buffer;
         size_t buffer_offset;
diff --git a/src/resolve/resolved-dnstls-gnutls.h b/src/resolve/resolved-dnstls-gnutls.h
--- a/src/resolve/resolved-dnstls-gnutls.h
+++ b/src/resolve/resolved-dnstls-gnutls.h
@@ -14,6 +14,8 @@
 
 struct DnsTlsServerData {
         gnutls_datum_t session_data;
+        /* Whether the server certificate was verified when 'session_data' was negotiated */
+        bool session_verified;
 };
 
 struct DnsTlsStreamData {
@@ -21,4 +23,6 @@
         gnutls_typed_vdata_st validation;
         int handshake;
         bool shutdown;
+        /* Whether the server certificate is verified on this connection */
+        bool verify;
 };
diff --git a/src/resolve/resolved-dnstls-openssl.c b/src/resolve/resolved-dnstls-openssl.c
--- a/src/resolve/resolved-dnstls-openssl.c
+++ b/src/resolve/resolved-dnstls-openssl.c
@@ -64,6 +64,7 @@
 int dnstls_stream_connect_tls(DnsStream *stream, DnsServer *server) {
         _cleanup_(BIO_freep) BIO *rb = NULL, *wb = NULL;
         _cleanup_(SSL_freep) SSL *s = NULL;
+        bool verify;
         int error, r;
 
         assert(stream);
@@ -86,12 +87,21 @@
                 return -ENOMEM;
 
         SSL_set_connect_state(s);
+
+        verify = dns_server_get_dns_over_tls_mode(server) == DNS_OVER_TLS_YES;
+
+        /* Resuming a session skips verifying the server certificate. Hence, if verification is required
+         * now, forget a session that was negotiated without it, e.g. before switching from opportunistic
+         * to strict mode. */
+        if (verify && server->dnstls_data.session && !server->dnstls_data.session_verified)
+                dnstls_server_free(server);
+
         r = SSL_set_session(s, server->dnstls_data.session);
         if (r == 0)
                 return -EIO;
         SSL_set_bio(s, TAKE_PTR(rb), TAKE_PTR(wb));
 
-        if (dns_server_get_dns_over_tls_mode(server) == DNS_OVER_TLS_YES) {
+        if (verify) {
                 X509_VERIFY_PARAM *v;
 
                 SSL_set_verify(s, SSL_VERIFY_PEER, NULL);
@@ -126,6 +136,7 @@
 
         stream->encrypted = true;
         stream->dnstls_data.ssl = TAKE_PTR(s);
+        stream->dnstls_data.verify = verify;
 
         r = dnstls_flush_write_buffer(stream);
         if (r < 0 && r != -EAGAIN) {
@@ -230,13 +241,16 @@
         assert(stream->encrypted);
         assert(stream->dnstls_data.ssl);
 
-        if (stream->server) {
+        /* Only save sessions of completed handshakes, as only those verified the server certificate if
+         * requested */
+        if (stream->server && stream->dnstls_data.handshake > 0) {
                 s = SSL_get1_session(stream->dnstls_data.ssl);
                 if (s) {
                         if (stream->server->dnstls_data.session)
                                 SSL_SESSION_free(stream->server->dnstls_data.session);
 
                         stream->server->dnstls_data.session = s;
+                        stream->server->dnstls_data.session_verified = stream->dnstls_data.verify;
                 }
         }
 
@@ -384,7 +398,9 @@
         assert(server);
 
         if (server->dnstls_data.session)
-                SSL_SESSION_free(server->dnstls_data.session);
+                SSL_SESSION_free(TAKE_PTR(server->dnstls_data.session));
+
+        server->dnstls_data.session_verified = false;
 }
 
 int dnstls_manager_init(Manager *manager) {
diff --git a/src/resolve/resolved-dnstls-gnutls.c b/src/resolve/resolved-dnstls-gnutls.c
--- a/src/resolve/resolved-dnstls-gnutls.c
+++ b/src/resolve/resolved-dnstls-gnutls.c
@@ -30,6 +30,7 @@
 
 int dnstls_stream_connect_tls(DnsStream *stream, DnsServer *server) {
         _cleanup_(gnutls_deinitp) gnutls_session_t gs = NULL;
+        bool verify;
         int r;
 
         assert(stream);
@@ -48,6 +49,17 @@
         if (r < 0)
                 return r;
 
+        verify = dns_server_get_dns_over_tls_mode(server) == DNS_OVER_TLS_YES;
+
+        /* Resuming a session skips verifying the server certificate. Hence, if verification is required
+         * now, forget a session that was negotiated without it, e.g. before switching from opportunistic
+         * to strict mode. */
+        if (verify && server->dnstls_data.session_data.size > 0 && !server->dnstls_data.session_verified) {
+                gnutls_free(server->dnstls_data.session_data.data);
+                server->dnstls_data.session_data.data = NULL;
+                server->dnstls_data.session_data.size = 0;
+        }
+
         if (server->dnstls_data.session_data.size > 0) {
                 gnutls_session_set_data(gs, server->dnstls_data.session_data.data, server->dnstls_data.session_data.size);
 
@@ -57,7 +69,7 @@
                 server->dnstls_data.session_data.size = 0;
         }
 
-        if (server->manager->dns_over_tls_mode == DNS_OVER_TLS_YES) {
+        if (verify) {
                 if (server->server_name)
                         gnutls_session_set_verify_cert(gs, server->server_name, 0);
                 else {
@@ -85,6 +97,7 @@
         gnutls_transport_set_vec_push_function(gs, &dnstls_stream_vec_push);
 
         stream->encrypted = true;
+        stream->dnstls_data.verify = verify;
         stream->dnstls_data.handshake = gnutls_handshake(gs);
         if (stream->dnstls_data.handshake < 0 && gnutls_error_is_fatal(stream->dnstls_data.handshake))
                 return -ECONNREFUSED;
@@ -145,9 +158,12 @@
         assert(stream->encrypted);
         assert(stream->dnstls_data.session);
 
-        /* Store TLS Ticket for faster successive TLS handshakes */
-        if (stream->server && stream->server->dnstls_data.session_data.size == 0 && stream->dnstls_data.handshake == GNUTLS_E_SUCCESS)
-                gnutls_session_get_data2(stream->dnstls_data.session, &stream->server->dnstls_data.session_data);
+        /* Store TLS Ticket for faster successive TLS handshakes. Only save the ticket of a completed
+         * handshake, as only that verified the server certificate if requested. */
+        if (stream->server && stream->server->dnstls_data.session_data.size == 0 && stream->dnstls_data.handshake == GNUTLS_E_SUCCESS) {
+                if (gnutls_session_get_data2(stream->dnstls_data.session, &stream->server->dnstls_data.session_data) >= 0)
+                        stream->server->dnstls_data.session_verified = stream->dnstls_data.verify;
+        }
 
         if (IN_SET(error, ETIMEDOUT, 0)) {
                 r = gnutls_bye(stream->dnstls_data.session, GNUTLS_SHUT_RDWR);
@@ -228,6 +244,10 @@
 
         if (server->dnstls_data.session_data.data)
                 gnutls_free(server->dnstls_data.session_data.data);
+
+        server->dnstls_data.session_data.data = NULL;
+        server->dnstls_data.session_data.size = 0;
+        server->dnstls_data.session_verified = false;
 }
 
 int dnstls_manager_init(Manager *manager) {
diff --git a/src/resolve/resolved-dns-server.c b/src/resolve/resolved-dns-server.c
--- a/src/resolve/resolved-dns-server.c
+++ b/src/resolve/resolved-dns-server.c
@@ -991,6 +991,13 @@
 
         dns_server_reset_counters(s);
 
+#if ENABLE_DNS_OVER_TLS
+        /* Forget the TLS session too. Whether the server certificate is verified is decided per connection
+         * from the current configuration, but resuming a session skips that verification. Hence a session
+         * negotiated without verification must not be resumed once verification is required. */
+        dnstls_server_free(s);
+#endif
+
         /* Let's close the default stream, so that we reprobe with the new features */
         dns_server_unref_stream(s);
 }
diff --git a/src/resolve/resolved-dns-transaction.c b/src/resolve/resolved-dns-transaction.c
--- a/src/resolve/resolved-dns-transaction.c
+++ b/src/resolve/resolved-dns-transaction.c
@@ -681,6 +681,7 @@
         _cleanup_close_ int fd = -EBADF;
         union sockaddr_union sa;
         DnsStreamType type;
+        bool reusable;
         int r;
 
         assert(t);
@@ -707,7 +708,22 @@
                                 return r;
                 }
 
-                if (t->server->stream && (DNS_SERVER_FEATURE_LEVEL_IS_TLS(t->current_feature_level) == t->server->stream->encrypted))
+                reusable = t->server->stream &&
+                        (DNS_SERVER_FEATURE_LEVEL_IS_TLS(t->current_feature_level) == t->server->stream->encrypted);
+
+#if ENABLE_DNS_OVER_TLS
+                /* The server certificate is verified during the handshake only. Hence a connection
+                 * established without verification must not serve further queries once verification is
+                 * required, e.g. after the link's DNSOverTLS= setting changed from opportunistic to yes. */
+                if (reusable && t->server->stream->encrypted &&
+                    !t->server->stream->dnstls_data.verify &&
+                    dns_server_get_dns_over_tls_mode(t->server) == DNS_OVER_TLS_YES) {
+                        dns_server_unref_stream(t->server);
+                        reusable = false;
+                }
+#endif
+
+                if (reusable)
                         s = dns_stream_ref(t->server->stream);
                 else
                         fd = dns_scope_socket_tcp(t->scope, AF_UNSPEC, NULL, t->server, dns_transaction_port(t), &sa);
