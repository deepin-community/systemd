From 0f4c27c44c5043794baf5a94c28364f2b32483fc Mon Sep 17 00:00:00 2001
From: Luca Boccassi <luca.boccassi@gmail.com>
Date: Fri, 20 Nov 2026 00:52:08 +0000
Subject: [PATCH] sd-json: refuse duplicate keys

I think it's better to be strict here. JSON allows duplicate keys, but
JSON-I doesn't. This has been a security issue before (JWT...), and
given there's no realistic, good reason to ever do this, let's just not
allow this.

(the security issue is that some json libs will use the last others the
first key on conflicts).

This is of course a compat break of a kind, but I think a minor one, for
good reasons, and we should just do it. Hence I added a blurb about it
to NEWS

[v255 backport note: this is a squashed backport of upstream commits
0efbe176d508a44d31b712842835014236901061 ("sort-util: add generic
cmp_string() + cmp_const_string() comparators"), b1849d4d3f2fbf688ef0
9990e044f81e5f97a566 ("sd-json: refuse objects with duplicate keys") and
0f4c27c44c5043794baf5a94c28364f2b32483fc ("sd-json: refuse duplicate
keys") to the systemd 255.2 tree. Adaptations:
- src/libsystemd/sd-json/sd-json.c does not exist in 255.2; the JSON
  implementation lives in src/shared/json.c and still uses the
  JsonVariant/json_variant_*() names, so all hunks were remapped there.
- src/basic/sort-util.c in 255.2 has no cmp_unsigned(); the new
  comparators were appended after cmp_uint16() and <string.h> was added.
- src/basic/strv.c in 255.2 has no strv_sort_uniq_full(); only
  strv_sort() was switched over to cmp_string().
- Dropped hunk: NEWS (255.2 carries the v255 NEWS, the v263 blurb does
  not apply).
- Dropped hunks: man/SD_JSON_BUILD_OBJECT.xml, man/sd_json_build.xml,
  man/sd_json_variant_new_object.xml, man/rules/meson.build and
  man/sd_json_parse.xml. systemd 255.2 does not ship any sd-json(3) man
  pages yet, so there is no file to add or patch.
- Dropped hunk: test/fuzz/fuzz-json/duplicate-keys (binary fuzz corpus
  file, content not recoverable from the upstream diff).
- Dropped hunk: test/units/TEST-74-AUX-UTILS.varlinkctl-unit-start-
  transient.sh, which does not exist in 255.2 (the varlinkctl tests are
  still a single test/units/testsuite-74.varlinkctl.sh and never had the
  duplicate-field dispatch test).
- src/libsystemd/sd-json/test-json.c was remapped to
  src/test/test-json.c and rewritten to the assert_se()/int-returning
  style used by that file, as 255.2 has no ASSERT_OK()/ASSERT_ERROR()
  macros and no json_buildo().]

---
 src/basic/sort-util.c | 20 +++++++++++++
 src/basic/sort-util.h |  6 ++++
 src/basic/strv.c      |  6 +---
 src/shared/json.c     | 63 +++++++++++++++++++++++++++++++++++++----
 src/test/test-json.c  | 77 +++++++++++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 162 insertions(+), 10 deletions(-)

diff --git a/src/basic/sort-util.c b/src/basic/sort-util.c
index 9eadb960..43212d3e 100644
--- a/src/basic/sort-util.c
+++ b/src/basic/sort-util.c
@@ -1,5 +1,7 @@
 /* SPDX-License-Identifier: LGPL-2.1-or-later */
 
+#include <string.h>
+
 #include "sort-util.h"
 #include "alloc-util.h"
 
@@ -35,3 +37,21 @@ int cmp_int(const int *a, const int *b) {
 int cmp_uint16(const uint16_t *a, const uint16_t *b) {
         return CMP(*a, *b);
 }
+
+int cmp_string(char * const *a, char * const *b) {
+        /* This is called from qsort()s inner loops. Correctly implemented qsort will never pass NULL so we
+           just suppress the check via POINTER_MAY_BE_NULL instead of assert() to avoid the runtime cost. */
+        POINTER_MAY_BE_NULL(a);
+        POINTER_MAY_BE_NULL(b);
+
+        return strcmp(*a, *b);
+}
+
+int cmp_const_string(const char * const *a, const char * const *b) {
+        /* This is called from qsort()s inner loops. Correctly implemented qsort will never pass NULL so we
+           just suppress the check via POINTER_MAY_BE_NULL instead of assert() to avoid the runtime cost. */
+        POINTER_MAY_BE_NULL(a);
+        POINTER_MAY_BE_NULL(b);
+
+        return strcmp(*a, *b);
+}
diff --git a/src/basic/sort-util.h b/src/basic/sort-util.h
index 9c818bd7..1773a516 100644
--- a/src/basic/sort-util.h
+++ b/src/basic/sort-util.h
@@ -77,3 +77,9 @@ static inline void qsort_r_safe(void *base, size_t nmemb, size_t size, compariso
 
 int cmp_int(const int *a, const int *b);
 int cmp_uint16(const uint16_t *a, const uint16_t *b);
+
+/* Compares two strings referenced by pointer, i.e. for sorting arrays of strings. There are two flavours,
+ * because typesafe_qsort() insists on exact types, and char* arrays and const char* arrays differ in that
+ * regard. */
+int cmp_string(char * const *a, char * const *b);
+int cmp_const_string(const char * const *a, const char * const *b);
diff --git a/src/basic/strv.c b/src/basic/strv.c
index c2109d35..71f57372 100644
--- a/src/basic/strv.c
+++ b/src/basic/strv.c
@@ -655,12 +655,8 @@ bool strv_overlap(char * const *a, char * const *b) {
         return false;
 }
 
-static int str_compare(char * const *a, char * const *b) {
-        return strcmp(*a, *b);
-}
-
 char** strv_sort(char **l) {
-        typesafe_qsort(l, strv_length(l), str_compare);
+        typesafe_qsort(l, strv_length(l), cmp_string);
         return l;
 }
 
diff --git a/src/shared/json.c b/src/shared/json.c
index 06c9e850..227650a2 100644
--- a/src/shared/json.c
+++ b/src/shared/json.c
@@ -22,6 +22,7 @@
 #include "memory-util.h"
 #include "memstream-util.h"
 #include "set.h"
+#include "sort-util.h"
 #include "string-table.h"
 #include "string-util.h"
 #include "strv.h"
@@ -699,10 +700,53 @@ int json_variant_new_array_strv(JsonVariant **ret, char **l) {
         return 0;
 }
 
+static int json_object_keys_unique(JsonVariant **array, size_t n) {
+        _cleanup_free_ const char **keys = NULL;
+        size_t n_keys = n / 2;
+
+        assert(array || n == 0);
+        assert(n % 2 == 0);
+
+        /* Returns > 0 if all keys of the specified key/value pair array are unique, 0 if there are
+         * duplicates, negative errno on error. Assumes every second element is a string. */
+
+        if (n_keys <= 1)
+                return true;
+
+        /* For small objects compare all keys with each other, that's cheaper than allocating anything */
+        if (n_keys <= 16) {
+                for (size_t i = 0; i < n_keys; i++)
+                        for (size_t j = i + 1; j < n_keys; j++)
+                                if (streq(json_variant_string(array[i*2]),
+                                          json_variant_string(array[j*2])))
+                                        return false;
+
+                return true;
+        }
+
+        /* For larger objects sort a copy of the key list and compare neighbours, so that adversarial input
+         * with lots of keys doesn't make us go quadratic. */
+        keys = new(const char*, n_keys);
+        if (!keys)
+                return -ENOMEM;
+
+        for (size_t i = 0; i < n_keys; i++)
+                keys[i] = json_variant_string(array[i*2]);
+
+        typesafe_qsort(keys, n_keys, cmp_const_string);
+
+        for (size_t i = 1; i < n_keys; i++)
+                if (streq(keys[i-1], keys[i]))
+                        return false;
+
+        return true;
+}
+
 int json_variant_new_object(JsonVariant **ret, JsonVariant **array, size_t n) {
         _cleanup_(json_variant_unrefp) JsonVariant *v = NULL;
         const char *prev = NULL;
         bool sorted = true, normalized = true;
+        int r;
 
         assert_return(ret, -EINVAL);
         if (n == 0) {
@@ -759,6 +803,16 @@ int json_variant_new_object(JsonVariant **ret, JsonVariant **array, size_t n) {
         v->normalized = normalized;
         v->sorted = sorted;
 
+        /* Refuse objects with duplicate keys. If the keys are strictly ordered they are necessarily unique,
+         * hence we only need to check explicitly if they are not. */
+        if (!sorted) {
+                r = json_object_keys_unique(array, n);
+                if (r < 0)
+                        return r;
+                if (r == 0)
+                        return -ENOTUNIQ;
+        }
+
         *ret = TAKE_PTR(v);
         return 0;
 }
@@ -4996,14 +5050,13 @@ int json_variant_sort(JsonVariant **v) {
 
         qsort(a, m/2, sizeof(JsonVariant*)*2, json_cmp_strings);
 
-        r = json_variant_new_object(&n, a, m);
+        r = json_variant_new_object(&n, a, m); /* Fails with -ENOTUNIQ on duplicate keys */
         if (r < 0)
                 return r;
 
         json_variant_propagate_sensitive(*v, n);
 
-        if (!n->sorted) /* Check if this worked. This will fail if there are multiple identical keys used. */
-                return -ENOTUNIQ;
+        assert(n->sorted); /* Keys are unique, hence sorting must have worked */
 
         JSON_VARIANT_REPLACE(*v, TAKE_PTR(n));
 
@@ -5053,8 +5106,8 @@ int json_variant_normalize(JsonVariant **v) {
 
         json_variant_propagate_sensitive(*v, n);
 
-        if (!n->normalized) { /* Let's see if normalization worked. It will fail if there are multiple
-                               * identical keys used in the same object anywhere, or if there are floating
+        if (!n->normalized) { /* Let's see if normalization worked. Duplicate keys are already refused by
+                               * json_variant_new_object(), but this will still fail if there are floating
                                * point numbers used (see below) */
                 r = -ENOTUNIQ;
                 goto finish;
diff --git a/src/test/test-json.c b/src/test/test-json.c
index c120a702..1fa1c497 100644
--- a/src/test/test-json.c
+++ b/src/test/test-json.c
@@ -751,6 +751,83 @@ TEST(json_array_append_nodup) {
         assert_se(json_variant_equal(s, nd));
 }
 
+static void test_duplicate_keys_parse_one(const char *text, int expected) {
+        _cleanup_(json_variant_unrefp) JsonVariant *v = NULL;
+        int r;
+
+        r = json_parse(text, /* flags= */ 0, &v, /* reterr_line= */ NULL, /* reterr_column= */ NULL);
+
+        if (expected == 0) {
+                assert_se(r == 0);
+                assert_se(v);
+        } else {
+                assert_se(r == expected);
+                assert_se(!v);
+        }
+}
+
+TEST(duplicate_keys) {
+        _cleanup_(json_variant_unrefp) JsonVariant *v = NULL, *a = NULL, *b = NULL, *c = NULL;
+
+        /* Parser */
+        test_duplicate_keys_parse_one("{\"a\":1,\"a\":2}", ENOTUNIQ);
+        test_duplicate_keys_parse_one("{\"a\":1,\"a\":1}", ENOTUNIQ);
+        test_duplicate_keys_parse_one("{\"b\":1,\"a\":2,\"b\":3}", ENOTUNIQ);
+        test_duplicate_keys_parse_one("{\"x\":{\"a\":1,\"a\":2}}", ENOTUNIQ);
+        test_duplicate_keys_parse_one("[{\"a\":1},{\"a\":1,\"b\":2,\"a\":3}]", ENOTUNIQ);
+        test_duplicate_keys_parse_one("{\"a\":1,\"\\u0061\":2}", ENOTUNIQ); /* same key after unescaping */
+        test_duplicate_keys_parse_one("{\"a\":1,\"A\":2}", /* expected= */ 0);
+        test_duplicate_keys_parse_one("{\"b\":1,\"a\":2}", /* expected= */ 0);
+        test_duplicate_keys_parse_one("[{\"a\":1},{\"a\":2}]", /* expected= */ 0);
+        test_duplicate_keys_parse_one("{\"a\":{\"a\":{\"a\":1}}}", /* expected= */ 0);
+
+        /* Large unsorted objects take a different code path, check that too, with the duplicate keys at
+         * opposite ends of the object */
+        _cleanup_free_ char *fields = NULL;
+        for (unsigned i = 0; i < 100; i++)
+                assert_se(strextendf_with_separator(&fields, ",", "\"k%u\":%u", 99 - i, i) >= 0);
+
+        _cleanup_free_ char *big = strjoin("{", fields, "}");
+        assert_se(big);
+        test_duplicate_keys_parse_one(big, /* expected= */ 0);
+
+        _cleanup_free_ char *big_dup = strjoin("{", fields, ",\"k99\":4711}");
+        assert_se(big_dup);
+        test_duplicate_keys_parse_one(big_dup, ENOTUNIQ);
+
+        /* Builder */
+        assert_se(json_build(&v,
+                             JSON_BUILD_OBJECT(
+                                             JSON_BUILD_PAIR_UNSIGNED("a", 1),
+                                             JSON_BUILD_PAIR_UNSIGNED("a", 2))) == -ENOTUNIQ);
+        assert_se(!v);
+        assert_se(json_build(&v,
+                             JSON_BUILD_OBJECT(
+                                             JSON_BUILD_PAIR_UNSIGNED("b", 1),
+                                             JSON_BUILD_PAIR_UNSIGNED("a", 2),
+                                             JSON_BUILD_PAIR_UNSIGNED("b", 3))) == -ENOTUNIQ);
+        assert_se(!v);
+        assert_se(json_build(&v,
+                             JSON_BUILD_OBJECT(
+                                             JSON_BUILD_PAIR_UNSIGNED("b", 1),
+                                             JSON_BUILD_PAIR_UNSIGNED("a", 2))) == 0);
+        assert_se(v);
+
+        /* Low-level constructor */
+        assert_se(json_variant_new_string(&a, "foo") == 0);
+        assert_se(json_variant_new_string(&b, "bar") == 0);
+        assert_se(json_variant_new_unsigned(&c, 4711) == 0);
+
+        JsonVariant *dup[] = { a, c, b, c, a, c };
+        assert_se(json_variant_new_object(&v, dup, ELEMENTSOF(dup)) == -ENOTUNIQ);
+        assert_se(v); /* unchanged on failure */
+
+        JsonVariant *nodup[] = { a, c, b, c };
+        v = json_variant_unref(v);
+        assert_se(json_variant_new_object(&v, nodup, ELEMENTSOF(nodup)) == 0);
+        assert_se(json_variant_elements(v) == 4U);
+}
+
 TEST(json_dispatch) {
         struct foobar {
                 uint64_t a, b;
