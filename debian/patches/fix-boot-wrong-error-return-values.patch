From 9f9dcb7d838f73efab19aa81900d5880b1deeb14 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Zbigniew=20J=C4=99drzejewski-Szmek?= <zbyszek@amutable.com>
Date: Wed, 18 Nov 2026 10:29:09 +0100
Subject: [PATCH] Fix wrong error return values in systemd-boot (#44638)

Follow-up for the work with errno logging that was merged previously.
Here there are some behaviour changes, so I extended the comments to
explain those. I think the changes are for the better, but please
double-check it.

[szdk: backport to v255: the EFI sources live in src/boot/efi/ and
pe_kernel_info() still has the old (base, ret_compat_address)
signature; adapt boot.c and linux.c to look up the compat entry point
before StartImage() so an unloaded image is never accessed. The shim
LoadImage/HandleProtocol error-mapping hunks and the pe.c native
entry-point validation target code that does not exist in v255 and
are dropped.]

---
--- a/src/boot/efi/boot.c
+++ b/src/boot/efi/boot.c
@@ -2378,30 +2378,41 @@
                 (void) tpm_log_load_options(options, NULL);
         }
 
+        /* The firmware cannot start a kernel built for a different architecture: StartImage() returns
+         * EFI_UNSUPPORTED and leaves the image loaded, and we call the kernel compat entry point instead.
+         * But an image that did run can exit with the same status, and it is unloaded by the time
+         * StartImage() returns. Hence look for the compat entry point now, while the image is still
+         * loaded. pe_kernel_info() only returns one for an image of a different architecture, i.e. one
+         * that the firmware did not start. */
+        EFI_IMAGE_ENTRY_POINT compat_entry = NULL;
+        EFI_STATUS compat_err = EFI_SUCCESS;
+        if (entry->type == LOADER_LINUX) {
+                uint32_t compat_address = 0;
+
+                compat_err = pe_kernel_info(loaded_image->ImageBase, &compat_address);
+                if (compat_err == EFI_SUCCESS && compat_address > 0)
+                        compat_entry = (EFI_IMAGE_ENTRY_POINT)
+                                ((uint8_t *) loaded_image->ImageBase + compat_address);
+        }
+
         efivar_set_time_usec(MAKE_GUID_PTR(LOADER), u"LoaderTimeExecUSec", 0);
         err = BS->StartImage(image, NULL, NULL);
         graphics_mode(false);
         if (err == EFI_SUCCESS)
                 return EFI_SUCCESS;
 
-        /* Try calling the kernel compat entry point if one exists. */
+        /* Try calling the kernel compat entry point if one exists. The image may be unloaded already,
+         * so don't access it here, see above. */
         if (err == EFI_UNSUPPORTED && entry->type == LOADER_LINUX) {
-                uint32_t compat_address;
-
-                err = pe_kernel_info(loaded_image->ImageBase, &compat_address);
-                if (err != EFI_SUCCESS) {
-                        if (err != EFI_UNSUPPORTED)
-                                return log_error_status(err, "Error finding kernel compat entry address: %m");
-                } else if (compat_address > 0) {
-                        EFI_IMAGE_ENTRY_POINT kernel_entry =
-                                (EFI_IMAGE_ENTRY_POINT) ((uint8_t *) loaded_image->ImageBase + compat_address);
+                if (!IN_SET(compat_err, EFI_SUCCESS, EFI_UNSUPPORTED))
+                        return log_error_status(compat_err, "Error finding kernel compat entry address: %m");
 
-                        err = kernel_entry(image, ST);
+                if (compat_entry) {
+                        err = compat_entry(image, ST);
                         graphics_mode(false);
                         if (err == EFI_SUCCESS)
                                 return EFI_SUCCESS;
-                } else
-                        err = EFI_UNSUPPORTED;
+                }
         }
 
         return log_error_status(err, "Failed to execute %ls (%ls): %m", entry->title_show, entry->loader);
--- a/src/boot/efi/linux.c
+++ b/src/boot/efi/linux.c
@@ -142,15 +142,19 @@
         if (err != EFI_SUCCESS)
                 return log_error_status(err, "Error registering initrd: %m");
 
+        /* The image may be unloaded by the time StartImage() returns, so look up the compat entry
+         * point while the image is still loaded. */
+        EFI_IMAGE_ENTRY_POINT compat_entry = NULL;
+        if (compat_address > 0)
+                compat_entry = (EFI_IMAGE_ENTRY_POINT) ((uint8_t *) loaded_image->ImageBase + compat_address);
+
         log_wait();
         err = BS->StartImage(kernel_image, NULL, NULL);
 
-        /* Try calling the kernel compat entry point if one exists. */
-        if (err == EFI_UNSUPPORTED && compat_address > 0) {
-                EFI_IMAGE_ENTRY_POINT compat_entry =
-                                (EFI_IMAGE_ENTRY_POINT) ((uint8_t *) loaded_image->ImageBase + compat_address);
+        /* Try calling the kernel compat entry point if one exists. The image may be unloaded already,
+         * so don't access it here, see above. */
+        if (err == EFI_UNSUPPORTED && compat_entry)
                 err = compat_entry(kernel_image, ST);
-        }
 
         return log_error_status(err, "Error starting kernel image: %m");
 }
