Description:
  Backport of upstream PR #33334 for v255.2. The upstream change calls
  bus_query_sender_pidref(), which was introduced later (upstream commit
  1b78be0bb567, "bus-util: add helper for getting PidRef structs from
  bus") and does not exist in v255. Add a v255-compatible version of the
  helper to src/shared/bus-util.[ch]: SD_BUS_CREDS_PIDFD and
  bus_creds_get_pidref() are not available in v255, so the helper
  acquires the sender PID via sd_bus_query_sender_creds() +
  sd_bus_creds_get_pid() and pins it with pidref_set_pid() (pidfd, with
  graceful fallback), matching the intent of the upstream change.
diff --git a/src/shared/bus-util.c b/src/shared/bus-util.c
index 4123152..3d9176a 100644
--- a/src/shared/bus-util.c
+++ b/src/shared/bus-util.c
@@ -604,6 +604,26 @@ int bus_reply_pair_array(sd_bus_message *m, char **l) {
         return sd_bus_send(NULL, reply, NULL);
 }
 
+int bus_query_sender_pidref(sd_bus_message *message, PidRef *ret) {
+        _cleanup_(sd_bus_creds_unrefp) sd_bus_creds *creds = NULL;
+        int r;
+
+        assert(message);
+        assert(ret);
+
+        /* Acquire a PidRef (pinned via pidfd where supported) of the sender of the given message. */
+        r = sd_bus_query_sender_creds(message, SD_BUS_CREDS_PID, &creds);
+        if (r < 0)
+                return r;
+
+        pid_t pid;
+        r = sd_bus_creds_get_pid(creds, &pid);
+        if (r < 0)
+                return r;
+
+        return pidref_set_pid(ret, pid);
+}
+
 static int method_dump_memory_state_by_fd(sd_bus_message *message, void *userdata, sd_bus_error *ret_error) {
         _cleanup_(memstream_done) MemStream m = {};
         _cleanup_free_ char *dump = NULL;
