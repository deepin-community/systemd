Index: deepin-systemd/src/journal/test-journald-config.c
===================================================================
--- deepin-systemd.orig/src/journal/test-journald-config.c
+++ deepin-systemd/src/journal/test-journald-config.c
@@ -47,4 +47,57 @@ TEST(config_compress) {
         COMPRESS_PARSE_CHECK("", true, UINT64_MAX);
 }
 
+static void keep_free_parse_check(const char *str, uint64_t expected_keep_free, uint64_t expected_permyriad) {
+        JournalMetrics m = { .keep_free = UINT64_MAX };
+
+        assert_se(config_parse_journal_keep_free("", "", 0, "", 0, "SystemKeepFree", 0, str, &m, NULL) >= 0);
+        assert_se(m.keep_free == expected_keep_free);
+        assert_se(m.keep_free_permyriad == expected_permyriad);
+}
+
+TEST(config_keep_free) {
+        /* Absolute sizes */
+        keep_free_parse_check("1K", UINT64_C(1024), 0);
+        keep_free_parse_check("1M", UINT64_C(1024) * 1024, 0);
+        keep_free_parse_check("1G", UINT64_C(1024) * 1024 * 1024, 0);
+
+        /* Percentages are stored verbatim as permyriad; they invalidate
+         * any absolute byte value, except 0% which means keep_free == 0. */
+        keep_free_parse_check("0%", 0, UINT64_C(0));
+        keep_free_parse_check("1%", UINT64_MAX, UINT64_C(100));
+        keep_free_parse_check("21%", UINT64_MAX, UINT64_C(2100));
+        keep_free_parse_check("100%", UINT64_MAX, UINT64_C(10000));
+
+        /* Empty means "pick automatically" */
+        keep_free_parse_check("", UINT64_MAX, 0);
+        keep_free_parse_check(NULL, UINT64_MAX, 0);
+
+        /* Invalid input is ignored (returns 0, so the rest of the config
+         * file keeps being parsed) and leaves the metrics untouched. */
+        JournalMetrics m = { .keep_free = UINT64_C(42), .keep_free_permyriad = UINT64_C(7) };
+        assert_se(config_parse_journal_keep_free("", "", 0, "", 0, "SystemKeepFree", 0, "blah", &m, NULL) == 0);
+        assert_se(m.keep_free == UINT64_C(42));
+        assert_se(m.keep_free_permyriad == UINT64_C(7));
+
+        /* The two fields are mutually exclusive: a percentage invalidates
+         * a previously configured absolute byte value, and vice versa. */
+        m.keep_free = UINT64_C(42);
+        m.keep_free_permyriad = UINT64_C(7);
+        assert_se(config_parse_journal_keep_free("", "", 0, "", 0, "SystemKeepFree", 0, "5%", &m, NULL) == 0);
+        assert_se(m.keep_free == UINT64_MAX);
+        assert_se(m.keep_free_permyriad == UINT64_C(500));
+
+        m.keep_free = UINT64_C(42);
+        m.keep_free_permyriad = UINT64_C(7);
+        assert_se(config_parse_journal_keep_free("", "", 0, "", 0, "SystemKeepFree", 0, "1G", &m, NULL) == 0);
+        assert_se(m.keep_free == UINT64_C(1073741824));
+        assert_se(m.keep_free_permyriad == UINT64_C(0)); /* cleared */
+
+        /* Out-of-range and malformed percentages are ignored. */
+        keep_free_parse_check("101%", UINT64_MAX, 0);
+        keep_free_parse_check("-1%", UINT64_MAX, 0);
+        keep_free_parse_check("%", UINT64_MAX, 0);
+        keep_free_parse_check("1.5%", UINT64_MAX, 150);
+}
+
 DEFINE_TEST_MAIN(LOG_INFO);
