From dcc0f62f1e5fcbb7e28e2f908baf8777abe628e7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Zbigniew=20J=C4=99drzejewski-Szmek?= <zbyszek@amutable.com>
Date: Fri, 23 Oct 2026 11:51:59 +0200
Subject: [PATCH] kernel-install: accept configuration files without a final
 newline (#44346)

kernel-install exits early when a populated devicetree or tries file has
no final newline. The plugins run with `set -e`, and `read` returns
failure at EOF even when it has assigned the value.

I changed the reads to accept values at EOF, clear inherited values and
validate them explicitly. Empty, newline-only or unreadable devicetree
configuration files are rejected before existing boot entries or kernel
files are changed. I added regression checks for the BLS and UKI copy
plugins.

I tested this change in an Ubuntu 26.04 container. I ran
`test-kernel-install` and ShellCheck on the changed scripts. I also
checked both plugins as an unprivileged user with dash, bash and BusyBox
ash.

Fixes #39881

Index: repo/src/kernel-install/90-loaderentry.install.in
===================================================================
--- repo.orig/src/kernel-install/90-loaderentry.install.in
+++ repo/src/kernel-install/90-loaderentry.install.in
@@ -93,10 +93,36 @@ if [ "$ENTRY_TOKEN" = "$MACHINE_ID" ] &&
     BOOT_OPTIONS="$BOOT_OPTIONS systemd.machine_id=$MACHINE_ID"
 fi
 
+# Read the devicetree configuration file before anything is removed or installed below, so that a
+# configuration file that is refused leaves the existing loader entries, kernel image and devicetree
+# blob of this kernel version untouched.
+DEVICETREE_FILE=
+if [ -n "$KERNEL_INSTALL_CONF_ROOT" ]; then
+    if [ -f "$KERNEL_INSTALL_CONF_ROOT/devicetree" ]; then
+        DEVICETREE_FILE="$KERNEL_INSTALL_CONF_ROOT/devicetree"
+    fi
+elif [ -f /etc/kernel/devicetree ]; then
+    DEVICETREE_FILE=/etc/kernel/devicetree
+elif [ -f /usr/lib/kernel/devicetree ]; then
+    DEVICETREE_FILE=/usr/lib/kernel/devicetree
+fi
+if [ -n "$DEVICETREE_FILE" ]; then
+    # 'read' fails if it hits the end of the file before a newline, even though it assigned the variable.
+    # Hence, here and for the tries file below, its exit status is ignored and the value is checked
+    # instead. The variable is cleared first, so that an inherited value is not used if opening fails.
+    DEVICETREE=
+    read -r DEVICETREE <"$DEVICETREE_FILE" || :
+    [ -z "$DEVICETREE" ] && {
+        echo "Error: '$DEVICETREE_FILE' is empty or cannot be read." >&2
+        exit 1
+    }
+fi
+
 TRIES_FILE="${KERNEL_INSTALL_CONF_ROOT:-/etc/kernel}/tries"
 
 if [ -f "$TRIES_FILE" ]; then
-    read -r TRIES <"$TRIES_FILE"
+    TRIES=
+    read -r TRIES <"$TRIES_FILE" || :
     if ! echo "$TRIES" | grep -q '^[0-9][0-9]*$'; then
         echo "$TRIES_FILE does not contain an integer." >&2
         exit 1
@@ -120,15 +146,6 @@ install -m 0644 "$KERNEL_IMAGE" "$KERNEL
 }
 chown root:root "$KERNEL_DEST" || :
 
-if [ -n "$KERNEL_INSTALL_CONF_ROOT" ]; then
-    if [ -f "$KERNEL_INSTALL_CONF_ROOT/devicetree" ]; then
-        read -r DEVICETREE <"$KERNEL_INSTALL_CONF_ROOT/devicetree"
-    fi
-elif [ -f /etc/kernel/devicetree ]; then
-    read -r DEVICETREE </etc/kernel/devicetree
-elif [ -f /usr/lib/kernel/devicetree ]; then
-    read -r DEVICETREE </usr/lib/kernel/devicetree
-fi
 if [ -n "$DEVICETREE" ]; then
     for prefix in \
         "$KERNEL_INSTALL_CONF_ROOT" \
Index: repo/src/kernel-install/90-uki-copy.install
===================================================================
--- repo.orig/src/kernel-install/90-uki-copy.install
+++ repo/src/kernel-install/90-uki-copy.install
@@ -56,7 +56,11 @@ fi
 TRIES_FILE="${KERNEL_INSTALL_CONF_ROOT:-/etc/kernel}/tries"
 
 if [ -f "$TRIES_FILE" ]; then
-    read -r TRIES <"$TRIES_FILE"
+    # 'read' fails if it hits the end of the file before a newline, even though it assigned TRIES, so
+    # ignore its exit status and check the value below. Clear TRIES first, so that an inherited value is
+    # not used if opening the file fails.
+    TRIES=
+    read -r TRIES <"$TRIES_FILE" || :
     if ! echo "$TRIES" | grep -q '^[0-9][0-9]*$'; then
         echo "$TRIES_FILE does not contain an integer." >&2
         exit 1
Index: repo/src/kernel-install/test-kernel-install.sh
===================================================================
--- repo.orig/src/kernel-install/test-kernel-install.sh
+++ repo/src/kernel-install/test-kernel-install.sh
@@ -123,6 +123,34 @@ grep -qE '^initrd .*/the-token/1.1.1/ini
 grep -qE 'image' "$BOOT_ROOT/the-token/1.1.1/linux"
 grep -qE 'initrd' "$BOOT_ROOT/the-token/1.1.1/initrd"
 
+# Tries and devicetree files without trailing newline are accepted (issue #39881)
+rm "$entry"
+printf '%s' '56' >"$D/sources/tries"
+printf '%s' 'subdir/whatever.dtb' >"$D/sources/devicetree"
+"$kernel_install" -v add 1.1.1 "$D/sources/linux" "$D/sources/initrd"
+test -f "$entry"
+grep -qE '^devicetree .*/the-token/1.1.1/whatever.dtb' "$entry"
+
+# Empty tries files and empty or newline-only devicetree files are refused before the previous entry,
+# kernel image and devicetree blob are touched
+check_refused() {
+    ( ! "$kernel_install" -v add 1.1.1 "$D/sources/linux-new" "$D/sources/initrd" 2>"$D/err" )
+    grep -qF "$1" "$D/err"
+    cmp "$D/entry.orig" "$entry"
+    cmp "$D/sources/linux" "$BOOT_ROOT/the-token/1.1.1/linux"
+    cmp "$D/sources/subdir/whatever.dtb" "$BOOT_ROOT/the-token/1.1.1/whatever.dtb"
+}
+echo 'new image' >"$D/sources/linux-new"
+cp "$entry" "$D/entry.orig"
+: >"$D/sources/tries"
+check_refused "$D/sources/tries does not contain an integer."
+echo '56' >"$D/sources/tries"
+for dt in '' $'\n'; do
+    printf '%s' "$dt" >"$D/sources/devicetree"
+    check_refused "Error: '$D/sources/devicetree' is empty or cannot be read."
+done
+echo 'subdir/whatever.dtb' >"$D/sources/devicetree"
+
 # Install UKI
 if [ -f "$ukify" ]; then
     cat >>"$D/sources/install.conf" <<EOF
@@ -331,3 +359,29 @@ KERNEL_INSTALL_PLUGINS="$D/10-plugin-fai
 ret=$?
 set -e
 test "$ret" -eq "42"
+
+###########################################
+# tests for tries file handling in 90-uki-copy.install
+###########################################
+uki_copy_add() {
+    KERNEL_INSTALL_CONF_ROOT="$D/uki-conf" \
+    KERNEL_INSTALL_LAYOUT=uki \
+    KERNEL_INSTALL_VERBOSE=1 \
+    KERNEL_INSTALL_ENTRY_TOKEN=the-token \
+    KERNEL_INSTALL_BOOT_ROOT="$D/uki-boot" \
+    KERNEL_INSTALL_STAGING_AREA="$D/uki-staging" \
+        "$uki_copy_install" add 2.0.0 "$D/uki-boot/the-token/2.0.0" "$D/sources/fake.efi"
+}
+mkdir "$D/uki-conf"
+echo 'fake UKI' >"$D/sources/fake.efi"
+
+# A tries file without trailing newline is accepted
+printf '%s' '3' >"$D/uki-conf/tries"
+uki_copy_add
+cmp "$D/sources/fake.efi" "$D/uki-boot/EFI/Linux/the-token-2.0.0+3.efi"
+
+# An empty tries file is refused before the previous UKI is removed
+: >"$D/uki-conf/tries"
+( ! uki_copy_add 2>"$D/err" )
+grep -qF "$D/uki-conf/tries does not contain an integer." "$D/err"
+test -f "$D/uki-boot/EFI/Linux/the-token-2.0.0+3.efi"
