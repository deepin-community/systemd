From 23c99f4d71a5e39556793d8a403b9692a3ee05e6 Mon Sep 17 00:00:00 2001
From: Wei-Lun Li <b84330808@gmail.com>
Date: Thu, 5 Nov 2026 17:40:00 +0000
Subject: [PATCH] time-util: fix operator precedence in
 format_timestamp_style() size check

The minimum buffer size check in format_timestamp_style() lacked
parentheses around the conditional expression. Since + binds more
tightly than == and ?:, it was parsed as

    (3 + 1 + 10 + style == TIMESTAMP_DATE) ? 0 : (1 + 8 + ... + 1)

i.e. the weekday and date were never accounted for, and the check only
required 12 to 21 bytes instead of 15 to 35. Usually the strftime()
calls catch a buffer that is too short later on. However, for timestamps
that are too large to be formatted, the "--- XXXX-XX-XX ..." placeholder
is copied with only an assert() guarding the buffer size, so e.g. a 20
byte buffer with TIMESTAMP_PRETTY resulted in an assertion failure
instead of NULL being returned (or in a buffer overflow with NDEBUG).

All callers in the tree use FORMAT_TIMESTAMP_MAX sized buffers, hence
this is not triggered in practice, but let's fix the check and add a
test.

--- a/src/basic/time-util.c	2026-11-11 02:09:49.
+++ b/src/basic/time-util.c	2026-11-11 02:14:26.
@@ -349,18 +349,6 @@
                 return snprintf_ok(buf, l, "@" USEC_FMT, t / USEC_PER_SEC);  /* round down μs → s */
         }
 
-        utc = IN_SET(style, TIMESTAMP_UTC, TIMESTAMP_US_UTC, TIMESTAMP_DATE);
-        us = IN_SET(style, TIMESTAMP_US, TIMESTAMP_US_UTC);
-
-        if (l < (size_t) (3 +                   /* week day */
-                          1 + 10 +              /* space and date */
-                          style == TIMESTAMP_DATE ? 0 :
-                          (1 + 8 +              /* space and time */
-                           (us ? 1 + 6 : 0) +   /* "." and microsecond part */
-                           1 + (utc ? 3 : 1)) + /* space and shortest possible zone */
-                          1))
-                return NULL; /* Not enough space even for the shortest form. */
-
         /* Let's not format times with years > 9999 */
         if (t > USEC_TIMESTAMP_FORMATTABLE_MAX) {
                 static const char* const xxx[_TIMESTAMP_STYLE_MAX] = {
@@ -371,10 +359,23 @@
                         [TIMESTAMP_DATE]   = "--- XXXX-XX-XX",
                 };
 
-                assert(l >= strlen(xxx[style]) + 1);
+                if (l < strlen(xxx[style]) + 1)
+                        return NULL;
                 return strcpy(buf, xxx[style]);
         }
 
+        utc = IN_SET(style, TIMESTAMP_UTC, TIMESTAMP_US_UTC, TIMESTAMP_DATE);
+        us = IN_SET(style, TIMESTAMP_US, TIMESTAMP_US_UTC);
+
+        if (l < (size_t) (3 +                     /* week day */
+                          1 + 10 +                /* space and date */
+                          (style == TIMESTAMP_DATE ? 0 :
+                           (1 + 8 +               /* space and time */
+                            (us ? 1 + 6 : 0) +    /* "." and microsecond part */
+                            1 + (utc ? 3 : 1))) + /* space and shortest possible zone */
+                          1))
+                return NULL; /* Not enough space even for the shortest form. */
+
         sec = (time_t) (t / USEC_PER_SEC); /* Round down */
 
         if (!localtime_or_gmtime_r(&sec, &tm, utc))
--- a/src/test/test-time-util.c	2026-11-11 02:07:25.
+++ b/src/test/test-time-util.c	2026-11-11 02:14:26.
@@ -657,6 +657,34 @@
         test_format_timestamp_one(USEC_INFINITY, TIMESTAMP_UTC, NULL);
 }
 
+static void test_format_timestamp_short_buffer_one(usec_t val, TimestampStyle style, const char *result) {
+        char buf[FORMAT_TIMESTAMP_MAX];
+
+        /* Any buffer too short for the result must be refused gracefully, without writing past its end,
+         * and a buffer that is just large enough must be accepted. */
+        for (size_t l = 0; l <= strlen(result); l++) {
+                memset(buf, 'x', sizeof(buf));
+                assert_se(!format_timestamp_style(buf, l, val, style));
+                assert_se(memeqbyte('x', buf + l, sizeof(buf) - l));
+        }
+
+        assert_se(streq_ptr(format_timestamp_style(buf, strlen(result) + 1, val, style), result));
+        assert_se(streq_ptr(format_timestamp_style(buf, sizeof(buf), val, style), result));
+}
+
+TEST(format_timestamp_short_buffer) {
+        test_format_timestamp_short_buffer_one(USEC_PER_SEC, TIMESTAMP_UTC, "Thu 1970-01-01 00:00:01 UTC");
+        test_format_timestamp_short_buffer_one(USEC_PER_SEC, TIMESTAMP_US_UTC, "Thu 1970-01-01 00:00:01.000000 UTC");
+        test_format_timestamp_short_buffer_one(USEC_PER_SEC, TIMESTAMP_DATE, "Thu 1970-01-01");
+        test_format_timestamp_short_buffer_one(USEC_PER_SEC, TIMESTAMP_UNIX, "@1");
+
+        test_format_timestamp_short_buffer_one(USEC_TIMESTAMP_FORMATTABLE_MAX + 1, TIMESTAMP_PRETTY, "--- XXXX-XX-XX XX:XX:XX");
+        test_format_timestamp_short_buffer_one(USEC_TIMESTAMP_FORMATTABLE_MAX + 1, TIMESTAMP_US, "--- XXXX-XX-XX XX:XX:XX.XXXXXX");
+        test_format_timestamp_short_buffer_one(USEC_TIMESTAMP_FORMATTABLE_MAX + 1, TIMESTAMP_UTC, "--- XXXX-XX-XX XX:XX:XX UTC");
+        test_format_timestamp_short_buffer_one(USEC_TIMESTAMP_FORMATTABLE_MAX + 1, TIMESTAMP_US_UTC, "--- XXXX-XX-XX XX:XX:XX.XXXXXX UTC");
+        test_format_timestamp_short_buffer_one(USEC_TIMESTAMP_FORMATTABLE_MAX + 1, TIMESTAMP_DATE, "--- XXXX-XX-XX");
+}
+
 static void test_parse_timestamp_one(const char *str, usec_t max_diff, usec_t expected) {
         usec_t usec = USEC_INFINITY;
         int r;
