From d0cf688a62c16f0f03580d7d250b4a338bb69824 Mon Sep 17 00:00:00 2001
From: Ibrahim Issa <ibrahimisssaa@gmail.com>
Date: Mon, 3 Aug 2026 16:13:14 +0200
Subject: [PATCH] resolved: return NXDOMAIN for .onion domains

RFC 7686 mandates that name resolution APIs MUST respond to .onion
names with NXDOMAIN to prevent leaks to the resolving name server.
This intercepts .onion queries and synthesizes an NXDOMAIN response locally.

Fixes #42980

diff --git a/src/shared/dns-domain.c b/src/shared/dns-domain.c
index a002c9a49a..25d01b8586 100644
--- a/src/shared/dns-domain.c
+++ b/src/shared/dns-domain.c
@@ -1368,6 +1368,10 @@ bool dns_name_dont_resolve(const char *name) {
         if (dns_name_endswith(name, "invalid") > 0)
                 return true;
 
+        /* Never respond to the domains listed in RFC7686 */
+        if (dns_name_endswith(name, "onion") > 0)
+                return true;
+
         /* Never respond to some of the domains listed in RFC9476 */
         if (dns_name_endswith(name, "alt") > 0)
                 return true;
